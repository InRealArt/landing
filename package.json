{
  "name": "ira-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npx prisma generate &&next build",
    "start": "next start",
    "lint": "next lint",
    "lighthouse": "lhci autorun --config=lighthouserc.json",
    "lighthouse:mobile": "lhci autorun --config=lighthouserc-mobile.json",
    "lighthouse:desktop": "lhci autorun --collect.url=http://localhost:3000 --collect.settings.preset=desktop --collect.numberOfRuns=3",
    "install:safe:prisma:inrealart": "npx dotenv-cli -e .env -- npm install @InRealArt/prisma-schema",
    "prisma:copy-schema": "cp node_modules/@InRealArt/prisma-schema/schema.prisma prisma/schema.prisma",
    "update:schema:inrealart": "npm run install:safe:prisma:inrealart && npm run prisma:copy-schema && npx prisma generate",
    "analyze": "ANALYZE=true npm run build",
    "test:perf": "npm run build && npm run start & sleep 5 && npm run lighthouse && kill %1"
  },
  "dependencies": {
    "@getbrevo/brevo": "^2.5.0",
    "@heroicons/react": "^2.2.0",
    "@InRealArt/prisma-schema": "^1.2.10",
    "@next/third-parties": "^15.2.4",
    "@prisma/client": "^6.5.0",
    "@react-pdf/renderer": "^4.3.0",
    "@types/dompurify": "^3.0.5",
    "chart.js": "^4.5.0",
    "dompurify": "^3.2.5",
    "firebase": "^11.5.0",
    "framer-motion": "^12.23.24",
    "gsap": "^3.14.2",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.471.0",
    "next": "15.1.11",
    "next-intl": "^3.9.4",
    "nuqs": "^2.4.3",
    "prisma": "^6.5.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-cookie-consent": "^9.0.0",
    "react-dom": "^19.0.0",
    "react-google-recaptcha-v3": "^1.10.1",
    "react-phone-number-input": "^3.4.12",
    "recharts": "^2.15.2",
    "sass": "^1.83.0",
    "sonner": "^2.0.3",
    "swiper": "^11.2.10",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.1.1",
    "@types/grecaptcha": "^3.0.9",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.11",
    "lighthouse": "^13.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
